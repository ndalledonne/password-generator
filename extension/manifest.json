{
  "manifest_version": 3,
  "name": "Générateur de mot de passe",
  "description": "Génère des mots de passe aléatoires et sécurisés en un clic. Aucune donnée envoyée, aucune permission demandée.",
  "version": "0.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Générer un mot de passe",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
